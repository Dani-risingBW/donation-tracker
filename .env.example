# Copy this file to .env and fill in real values. .env is ignored by git.

# Gmail account that sends donor thank-you emails, and a Gmail app password
# for it (Google Account > Security > 2-Step Verification > App passwords).
MAIL_USERNAME=spreadmatthew2535@gmail.com
MAIL_PASSWORD=
MAIL_SENDER_NAME=Spread 25:35

# Google Forms volunteer sign-up link. Google may require respondents to sign in.
# Paste the complete share URL here; it appears on the site and in thank-you emails.
VOLUNTEER_FORM_URL=

# Production database. Leave unset to use local SQLite.
DATABASE_URL=

# Private Supabase Storage bucket for production payment screenshots.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=payment-screenshots

# Optional redacted audit-log analysis. Leave GEMINI_API_KEY empty to disable.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
