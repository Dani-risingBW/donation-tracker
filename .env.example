# Copy this file to .env and fill in real values. .env is ignored by git.

# Gmail account that sends donor thank-you emails, and a Gmail app password
# for it (Google Account > Security > 2-Step Verification > App passwords).
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SENDER_NAME=Spread 25:35

# Link to the volunteer sign-up form shown in thank-you emails.
VOLUNTEER_FORM_URL=[Template]
